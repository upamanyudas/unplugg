1 ICON "@ICON@"
1 24 "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Upa Das"
            VALUE "FileDescription", "unplugg"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "unplugg"
            VALUE "LegalCopyright", "Copyright (C) 2025 Upa Das. MIT License."
            VALUE "OriginalFilename", "unplugg.exe"
            VALUE "ProductName", "unplugg"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
